<?xml version="1.0" encoding="utf-8"?>
<!--
  MINIMAL first-logon Autounattend.xml for WindowsIsoMaker.

  Generated by New-FirstLogonUnattendXml and written to the ROOT of a USB installation stick by
  New-PostInstallUsb. Windows Setup picks up an Autounattend.xml found at the root of removable
  media automatically.

  This file deliberately contains ONLY the oobeSystem pass with FirstLogonCommands. It does NOT
  configure disks, editions, product keys or OOBE, so Windows Setup runs exactly as it normally
  would on the stock media (interactive edition / partition selection, normal OOBE including an
  Entra ID sign-in). The only added behaviour is that the listed commands run once, elevated, at
  the first logon.

  For the full answer file (unattended install, disk layout, edition selection) see
  templates/autounattend/autounattend.xml.template, which is used by the ISO build path.

  Tokens substituted at render time (braces omitted here so this comment is not substituted):
    PROCESSOR_ARCHITECTURE  amd64 | arm64
    DESCRIPTION             human-readable note describing what will run
    FIRSTLOGON_FRAGMENT     the rendered FirstLogonCommands block

  No password or secret is ever written into this file.
-->
<unattend xmlns="urn:schemas-microsoft-com:unattend">

  <settings pass="oobeSystem">
    <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="{{PROCESSOR_ARCHITECTURE}}" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <!-- {{DESCRIPTION}} -->
{{FIRSTLOGON_FRAGMENT}}
    </component>
  </settings>

</unattend>
